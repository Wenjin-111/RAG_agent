DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/new_rag

# Chat LLM (DeepSeek)
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=sk-your-deepseek-api-key
CHAT_MODEL_NAME=deepseek-chat

# Embedding Model (阿里云 text-embedding-v4)
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-dashscope-api-key
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# JWT
AUTH_JWT_SECRET=change-me-to-a-32byte-secret-key-minimum-change-this

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Elasticsearch
ES_HOST=127.0.0.1
ES_PORT=9200

# Dev Admin
DEV_ADMIN_ENABLED=true
DEV_ADMIN_EMAIL=admin@argus.local
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=Admin@123456

# MinerU 云端文档解析（https://mineru.net/apiManage/token 免费创建）
MINERU_TOKEN=sk-your-mineru-token
MINERU_MODEL=vlm
# 模型说明: vlm（精度高，复杂版式/扫描件/公式）/ pipeline（零幻觉，内容逐字准确）
